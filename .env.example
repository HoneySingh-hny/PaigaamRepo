# Copy this file to ".env" and fill in what you need. Never commit ".env".
PORT=3000
# Optional: enables the Paigaam AI assistant with Google Gemini (server-side only)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Optional: 64 hex chars (32 bytes) used to encrypt stored messages. Auto-generated into data/ if empty.
# MESSAGE_KEY=
# Optional: where the database and uploads live (use a persistent disk when deploying)
# DATA_DIR=./data
